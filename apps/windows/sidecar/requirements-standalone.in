# Direct dependencies for the SpektraFilm Windows sidecar runtime.
# Pins match the runtime ranges in the repository pyproject.toml.
#
# Not included, on purpose:
# - PySide6, qtpy, napari, pyconify: the Qt research GUI is not this shell.
# - markdown: LUT-creator only.
# - pyfftw: nothing on the preview, scan, or RAW path imports it.
# - pytest, opencolorio: development tools.
#
# Regenerate the Windows lock from the repository root:
#   uv pip compile apps/windows/sidecar/requirements-standalone.in \
#     --python-version 3.13 \
#     --python-platform x86_64-pc-windows-msvc \
#     --only-binary :all: \
#     --generate-hashes \
#     -o apps/windows/sidecar/requirements-standalone-win.lock

numpy~=2.4
scipy~=1.17
colour-science~=0.4.6
scikit-image~=0.26
matplotlib~=3.10
opt-einsum~=3.4.0
numba~=0.64
OpenImageIO~=3.1.11
rawpy~=0.26.1
exiv2~=0.18.1
lensfunpy~=1.18.0
